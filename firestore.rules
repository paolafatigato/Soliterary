rules_version = '2';
// Paste this in Firebase console > Firestore Database > Rules > Publish.
// Everybody can read and write only their own private document, and nobody can make themselves Pro
// (the "pro" field will be set by a Cloud Function after a payment).
// The social parts (profiles, friend codes, friends, weekly challenge, duels) are explained in net.js and cloud.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // the owner (verified email, e.g. signed in with Google) can be Pro without paying
    function isOwner() {
      return request.auth.token.email == 'paola.fatigato@gmail.com' && request.auth.token.email_verified == true;
    }

    // ---- private account: stories solved, stats, Pro
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
                    && (request.resource.data.get('pro', false) == false || isOwner());
      allow update: if signedIn() && request.auth.uid == uid
                    && (request.resource.data.get('pro', false) == resource.data.get('pro', false) || isOwner());

      // people I added: I write my own list; the person I added can read their entry (that is how friendship is checked)
      match /friends/{fid} {
        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == fid);
        allow write: if signedIn() && request.auth.uid == uid;
      }
      // friend requests: anybody can ask (writing only their own entry); only I can read and answer
      match /requests/{from} {
        allow create, update: if signedIn() && request.auth.uid == from;
        allow read, delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == from);
      }
    }

    // ---- public card: nickname and game numbers, no email
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // ---- friend codes
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
    }

    // ---- weekly challenge: the first player writes the plan, then everybody has one entry that can only improve
    match /events/{week} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ids.size() == 4;
      match /entries/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid
                      && request.resource.data.bestTime is number && request.resource.data.bestTime >= 25
                      && request.resource.data.bestMoves is number && request.resource.data.bestMoves >= 15;
        allow update: if signedIn() && request.auth.uid == uid
                      && request.resource.data.bestTime is number && request.resource.data.bestTime >= 25
                      && request.resource.data.bestMoves is number && request.resource.data.bestMoves >= 15
                      && request.resource.data.bestTime <= resource.data.bestTime
                      && request.resource.data.bestMoves <= resource.data.bestMoves;
      }
    }

    // ---- duels between two friends: only the two players can see and play them
    match /duels/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.players;
      allow create: if signedIn() && request.auth.uid == request.resource.data.from
                    && request.resource.data.players.size() == 2 && request.auth.uid in request.resource.data.players;
      allow update: if signedIn() && request.auth.uid in resource.data.players
                    && request.resource.data.players == resource.data.players
                    && request.resource.data.ids == resource.data.ids;
    }
  }
}
